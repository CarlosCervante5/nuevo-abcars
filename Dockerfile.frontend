# Frontend Angular - usar desde raíz del repo (contexto = raíz).
# En Railway: Root Directory vacío, Dockerfile Path = Dockerfile.frontend

FROM node:20-alpine AS build
WORKDIR /app

COPY abcars-frontend/package.json abcars-frontend/package-lock.json* ./
RUN npm ci

COPY abcars-frontend/ .

# Los environment están en .gitignore; crearlos aquí con API_URL del build
ARG API_URL=https://backend.abcars.mx
RUN mkdir -p src/environments && \
    echo "export const environment = { production: false, baseUrl: 'http://localhost:8000' };" > src/environments/environment.ts && \
    echo "export const environment = { production: true, baseUrl: '${API_URL}' };" > src/environments/environment.production.ts

RUN npm run build -- --configuration=production

FROM node:20-alpine
WORKDIR /app
RUN npm install -g serve

COPY --from=build /app/dist/abcars-frontend/browser ./browser

ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "serve -s browser -l ${PORT}"]
