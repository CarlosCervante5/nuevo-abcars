# Usado por `npm run build` / APK Android (Capacitor empaqueta este bundle).
VITE_API_BASE_URL=https://nuevo-abcars-sandbox.up.railway.app/api/

# Google AI Studio (Gemini). Si queda vacío, la app intenta solo el proxy Laravel (GEMINI_API_KEY en servidor).
