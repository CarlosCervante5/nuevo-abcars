# Copiar a `.env` o `.env.production.local` para desarrollo / builds locales.
# La clave Gemini no debe subirse a git: usa `.env.production.local` o exporta `VITE_GEMINI_API_KEY` en el CI.

# Producción / APK: también existe `.env.production` con la misma URL para `vite build`.

# API Laravel. Debe acabar en /api/ (si pones solo el host de Railway, se añade /api solo).
# Sandbox (dev/pruebas): https://nuevo-abcars-sandbox.up.railway.app/api/
# Producción (release / APK — ver `.env.production`):
VITE_API_BASE_URL=https://nuevo-abcars-sandbox.up.railway.app/api/

# Gemini (Google AI Studio). Si está vacío, en nativo se usa el proxy Laravel si el servidor tiene GEMINI_API_KEY.
VITE_GEMINI_API_KEY=

# Opcional (por defecto https://generativelanguage.googleapis.com):
# VITE_GEMINI_API_BASE_URL=

# Solo en `npm run dev`: usa proxy Vite /gemini-api para evitar CORS de Google.
# VITE_GEMINI_USE_DEV_PROXY=1
