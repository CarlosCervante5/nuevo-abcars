# Copia este archivo como `.env` en la raíz de `abcars-imagen-studio`.

# API key de Google AI Studio (Gemini).
# https://aistudio.google.com/apikey

VITE_GEMINI_API_KEY=tu_api_key

# Opcional: base URL sin barra final si enrutas por un backend propio.
# Si no se define, en producción se usa https://generativelanguage.googleapis.com
# y en desarrollo el proxy de Vite: /gemini-api → ese mismo host.

# VITE_GEMINI_API_ORIGIN=

# Opcional: en desarrollo, pon 0 para no usar el proxy /gemini-api (requiere CORS en Google).

# VITE_GEMINI_DEV_PROXY=0
